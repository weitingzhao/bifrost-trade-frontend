# Local Compose — Trade APIs via nginx :80 (single gateway).
VITE_API_BASE=http://localhost:80
# Empty → /api/plugin/market-data via Trade gateway (Compose nginx or K3s).
# Escape hatch: http://localhost:8780/api/v1/plugins/market-data/api
VITE_API_MARKET_DATA_PLUGIN=
# Empty → /api/plugin/flex-query via Trade gateway.
VITE_API_FLEX_QUERY_PLUGIN=
VITE_OPS_CONSOLE_URL=http://127.0.0.1:5180
