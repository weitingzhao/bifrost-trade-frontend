# Local Compose — Trade APIs via nginx :80 (single gateway, Phase B).
VITE_API_BASE=http://localhost:80
# Empty → /api/plugin/market-data via Trade gateway. Escape: platform-api absolute URL.
VITE_API_MARKET_DATA_PLUGIN=
# Empty → /api/plugin/flex-query via Trade gateway.
VITE_API_FLEX_QUERY_PLUGIN=
# Optional: OPT quote poll interval (ms) when Live passes contract_keys. Default shared poll = 8000.
# VITE_OPT_QUOTE_POLL_MS=8000
VITE_OPS_CONSOLE_URL=http://127.0.0.1:5180
