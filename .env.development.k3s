# Vision V1 / trade-dev-inner-loop — Mac thin + K3s thick (D-IL1).
# Usage: npm run env:k3s  OR  npm run dev:k3s
# Vite :5173 → bifrost-dev NodePort http://192.168.10.73:30882
# Phase B: single VITE_API_BASE for all Trade domains (P7: no api-massive).

VITE_API_BASE=http://192.168.10.73:30882
# Empty → same-origin /api/plugin/market-data via Trade gateway :30882 (matches PROD).
VITE_API_MARKET_DATA_PLUGIN=
# Empty → same-origin /api/plugin/flex-query via Trade gateway :30882 (matches PROD).
VITE_API_FLEX_QUERY_PLUGIN=
# Local Research Engine (:8795) until Trade Traefik exposes /api/plugin/research.
VITE_API_RESEARCH_ENGINE=http://127.0.0.1:8795
VITE_OPS_CONSOLE_URL=http://127.0.0.1:5180
