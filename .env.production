# Same-origin Trade gateway paths via Traefik / nginx (Phase B).
# Empty VITE_API_BASE → browser uses /api/{domain}/… on the SPA origin.
# Empty VITE_API_MARKET_DATA_PLUGIN → /api/plugin/market-data/… (gateway → market-data-api).
VITE_API_BASE=
VITE_API_MARKET_DATA_PLUGIN=
# Empty → /api/plugin/flex-query/… (gateway → flex-query-api).
VITE_API_FLEX_QUERY_PLUGIN=
# Bifrost Ops Console (LAN or localhost — optional peer link in sidebar)
VITE_OPS_CONSOLE_URL=http://127.0.0.1:5180
# Empty VITE_API_RESEARCH_ENGINE → /api/plugin/research/… (Trade gateway → research-api:8795)
VITE_API_RESEARCH_ENGINE=
