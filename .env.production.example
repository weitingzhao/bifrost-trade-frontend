# Production build — same-origin API paths via Traefik / nginx (Phase B).
# Copy to .env.production before `docker compose build frontend` or `npm run build`.
# Empty VITE_API_BASE → browser uses /api/{domain}/… on the SPA origin.
# Empty VITE_API_MARKET_DATA_PLUGIN → /api/plugin/market-data/… (Trade gateway → market-data-api).
# Optional absolute escape hatch: http://192.168.10.73:30876/api/v1/plugins/market-data/api
VITE_API_BASE=
VITE_API_MARKET_DATA_PLUGIN=
# Empty VITE_API_FLEX_QUERY_PLUGIN → /api/plugin/flex-query/… (Trade gateway → flex-query-api).
# Optional absolute escape hatch: http://192.168.10.73:30876/api/v1/plugins/flex-query/api
VITE_API_FLEX_QUERY_PLUGIN=
# Bifrost Ops Console (LAN or localhost — optional peer link in sidebar)
VITE_OPS_CONSOLE_URL=http://127.0.0.1:5180
