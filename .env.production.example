# Production build — same-origin API paths via infra nginx (Phase 2C / Phase B).
# Copy to .env.production before `docker compose build frontend` or `npm run build`.
# Empty VITE_API_BASE → browser uses /api/{domain}/… on the SPA origin.
VITE_API_BASE=
VITE_API_MARKET_DATA_PLUGIN=http://localhost:8780/api/v1/plugins/market-data/api
# Bifrost Ops Console (LAN or localhost — optional peer link in sidebar)
VITE_OPS_CONSOLE_URL=http://127.0.0.1:5180
